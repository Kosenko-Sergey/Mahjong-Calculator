<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Mahjong_Calculator"
             xmlns:view="clr-namespace:Mahjong_Calculator.View"
             xmlns:data="clr-namespace:Mahjong_Calculator.Data"
             x:Class="Mahjong_Calculator.View.MainPage"
             FlowDirection="LeftToRight">

    <Grid RowDefinitions="*, Auto">

        <ScrollView Grid.Row="0">


            <StackLayout BackgroundColor="#ffffff" Padding="5, 0" >
                <Label Text="Открыто:"></Label>
                <Border BackgroundColor="#dde" Padding="0" >
                    <FlexLayout Padding="0" HorizontalOptions="Center" VerticalOptions="Center" Wrap="Wrap" JustifyContent="Center">

                        <view:MeldView BindableLayout.ItemsSource="{DynamicResource Kang}"></view:MeldView>
                        <view:MeldView BindableLayout.ItemsSource="{DynamicResource Kang}"></view:MeldView>
                        <view:MeldView BindableLayout.ItemsSource="{DynamicResource Kang}"></view:MeldView>

                    </FlexLayout>
                </Border>
                <Label Text="Закрыто:"></Label>


                <Border BackgroundColor="#dde" Padding="0" Margin="0, 0, 0, 5">
                    <FlexLayout Padding="0" HorizontalOptions="Center" VerticalOptions="Center" Wrap="Wrap" JustifyContent="Center">

                        <view:MeldView BindableLayout.ItemsSource="{DynamicResource Kang}"></view:MeldView>

                    </FlexLayout>
                </Border>


                <Grid ColumnDefinitions="*, Auto">

                    <StackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label Text="Ветер раунда:" HorizontalOptions="Center"></Label>
                        <Picker Title="Ветер раунда" FontAutoScalingEnabled="True" HorizontalOptions="Fill" HorizontalTextAlignment="Center" >
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Восточный</x:String>
                                    <x:String>Южный</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                            <Picker.SelectedIndex>0</Picker.SelectedIndex>
                        </Picker>

                        <Label Text="Ветер места:" HorizontalOptions="Center"></Label>
                        <Picker Title="Ветер места" FontAutoScalingEnabled="True" HorizontalOptions="Fill" HorizontalTextAlignment="Center">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Восточный</x:String>
                                    <x:String>Южный</x:String>
                                    <x:String>Западный</x:String>
                                    <x:String>Северный</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                            <Picker.SelectedIndex>0</Picker.SelectedIndex>
                        </Picker>
                    </StackLayout>



                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Дора:" HorizontalOptions="Center"></Label>
                        <Border BackgroundColor="#dde" Margin="5, 5, 0, 5">
                            <VerticalStackLayout>
                                <VerticalStackLayout>
                                    <view:MeldView BindableLayout.ItemsSource="{DynamicResource Dora}"></view:MeldView>
                                </VerticalStackLayout>

                                <VerticalStackLayout>
                                    <view:MeldView BindableLayout.ItemsSource="{DynamicResource Dora}"></view:MeldView>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>


                </Grid>


                <Label Text="Яку-ситуации:" HorizontalOptions="Start"></Label>
                <Border BackgroundColor="#eee" Margin="0, 5, 5, 5" StrokeShape="RoundRectangle 10" IsVisible="True">
                    <Grid RowDefinitions="*, *, *, *, *, *" HeightRequest="200" Padding="5" Margin="0" ColumnSpacing="5" RowSpacing="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Grid.Row="0" ></CheckBox>
                        <CheckBox Grid.Column="0" Grid.Row="1"></CheckBox>
                        <CheckBox Grid.Column="0" Grid.Row="2"></CheckBox>
                        <CheckBox Grid.Column="0" Grid.Row="3"></CheckBox>
                        <CheckBox Grid.Column="0" Grid.Row="4"></CheckBox>
                        <CheckBox Grid.Column="0" Grid.Row="5"></CheckBox>

                        <CheckBox Grid.Column="2" Grid.Row="0"></CheckBox>
                        <CheckBox Grid.Column="2" Grid.Row="1"></CheckBox>
                        <CheckBox Grid.Column="2" Grid.Row="2"></CheckBox>
                        <CheckBox Grid.Column="2" Grid.Row="3"></CheckBox>
                        <CheckBox Grid.Column="2" Grid.Row="4"></CheckBox>
                        <CheckBox Grid.Column="2" Grid.Row="5"></CheckBox>

                        <Label Grid.Column="1" Grid.Row="0" Text="Риичи"></Label>
                        <Label Grid.Column="1" Grid.Row="1" Text="Иппацу"></Label>
                        <Label Grid.Column="1" Grid.Row="2" Text="Мензен цумо"></Label>
                        <Label Grid.Column="1" Grid.Row="3" Text="Хайтэй раоюэ"></Label>
                        <Label Grid.Column="1" Grid.Row="4" Text="Хотэй раоюй"></Label>
                        <Label Grid.Column="1" Grid.Row="5" Text="Ринщан кайхо"></Label>

                        <Label Grid.Column="3" Grid.Row="0" Text="Чанкан"></Label>
                        <Label Grid.Column="3" Grid.Row="1" Text="Дабури"></Label>
                        <Label Grid.Column="3" Grid.Row="2" Text="Тенхо"></Label>
                        <Label Grid.Column="3" Grid.Row="3" Text="Чихо"></Label>
                        <Label Grid.Column="3" Grid.Row="4" Text="Ренхо"></Label>
                        <Label Grid.Column="3" Grid.Row="5" Text="Нагащи манган"></Label>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="Auto, *">
                    <Label Text="Ожидание:" Grid.Column="0" VerticalTextAlignment="Center"></Label>
                    <Picker Title="Ожидание" Grid.Column="1">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>какое-то, хз какое</x:String>
                                <x:String>в дырку</x:String>
                                <x:String>в пару</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                        <Picker.SelectedIndex>0</Picker.SelectedIndex>
                    </Picker>
                </Grid>

            </StackLayout>


        </ScrollView>
        
        <Button Grid.Row="1" Text="Посчитать" FontSize="Medium"></Button>
    </Grid>
</ContentPage>





